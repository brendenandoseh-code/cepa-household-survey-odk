e><label>Irrigation (Fato-Fato)</label></item><item><name>farming_inputs</name><label>Distribute farming tools and seeds</label></item><item><name>livestock_support</name><label>Support for raising livestock</label></item><item><name>income_generation</name><label>Create income opportunities</label></item><item><name>community_collaboration</name><label>More community collaboration</label></item><item><name>other</name><label>Other</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/today" jr:preload="date" type="date" jr:preloadParams="today"/><bind nodeset="/data/visit/enumerator" type="string" required="true()"/><bind nodeset="/data/visit/village" type="string" required="true()"/><bind nodeset="/data/visit/visit_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="The visit date cannot be in the future."/><setvalue ref="/data/visit/visit_date" event="odk-instance-first-load" value="today()"/><bind nodeset="/data/consent_intro" readonly="true()" type="string"/><bind nodeset="/data/consent" type="string" required="true()"/><bind nodeset="/data/consent_declined" readonly="true()" type="string" relevant=" /data/consent  = 'no'"/><bind nodeset="/data/composition" relevant=" /data/consent  = 'yes'"/><bind nodeset="/data/composition/household_size" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 30" jr:constraintMsg="Household size must be between 1 and 30. Confirm the answer."/><bind nodeset="/data/composition/single_parents" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/composition/household_size " jr:constraintMsg="Cannot exceed the household size you entered."/><bind nodeset="/data/composition/people_over_65" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/composition/household_size " jr:constraintMsg="Cannot exceed the household size you entered."/><bind nodeset="/data/health" relevant=" /data/consent  = 'yes'"/><bind nodeset="/data/health/hiv_note" readonly="true()" type="string"/><bind nodeset="/data/health/people_with_hiv" type="int" constraint=". &gt;= 0 and . &lt;=  /data/composition/household_size " jr:constraintMsg="Cannot exceed the household size you entered."/><bind nodeset="/data/livelihoods" relevant=" /data/consent  = 'yes'"/><bind nodeset="/data/livelihoods/income_source" type="string" required="true()"/><bind nodeset="/data/livelihoods/income_source_other" type="string" required="true()" relevant="selected( /data/livelihoods/income_source , 'other')"/><bind nodeset="/data/livelihoods/strengths" type="string" required="true()"/><bind nodeset="/data/livelihoods/strengths_other" type="string" required="true()" relevant="selected( /data/livelihoods/strengths , 'other')"/><bind nodeset="/data/livelihoods/challenges" type="string" required="true()"/><bind nodeset="/data/livelihoods/challenges_other" type="string" required="true()" relevant="selected( /data/livelihoods/challenges , 'other')"/><bind nodeset="/data/livelihoods/opportunities" type="string" required="true()"/><bind nodeset="/data/livelihoods/opportunities_other" type="string" required="true()" relevant="selected( /data/livelihoods/opportunities , 'other')"/><bind nodeset="/data/livelihoods/notes" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><group appearance="field-list" ref="/data/visit"><label>Visit details</label><input ref="/data/visit/enumerator"><label>Enumerator name</label><hint>Person conducting this interview.</hint></input><select1 ref="/data/visit/village"><label>Village</label><hint>Ha Monyake chiefdom covers three villages.</hint><itemset nodeset="instance('village')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/visit/visit_date"><label>Date of visit</label></input></group><input ref="/data/consent_intro"><label>Read aloud: I am collecting information about households in this village to help plan health and community projects. Your answers are confidential and no names are recorded. You may skip any question or stop at any time.</label></input><select1 ref="/data/consent" appearance="minimal"><label>Does the household representative agree to take part?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/consent_declined"><label>No consent given. Please end the interview here and submit this form.</label></input><group ref="/data/composition"><label>Household composition</label><input ref="/data/composition/household_size"><label>How many people live in this household?</label></input><input ref="/data/composition/single_parents"><label>How many single parents live in this household?</label></input><input ref="/data/composition/people_over_65"><label>How many household members are aged 65 or over?</label></input></group><group ref="/data/health"><label>Health</label><input ref="/data/health/hiv_note"><label>Read aloud: The next question is optional. You do not have to answer it.</label></input><input ref="/data/health/people_with_hiv"><label>How many household members are living with HIV?</label><hint>Leave blank if the respondent prefers not to answer.</hint></input></group><group ref="/data/livelihoods"><label>Livelihoods and community</label><select ref="/data/livelihoods/income_source"><label>What are the main sources of household income?</label><hint>Select all that apply.</hint><itemset nodeset="instance('income_source')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/livelihoods/income_source_other"><label>Please specify the other income source</label></input><select ref="/data/livelihoods/strengths"><label>What skills or strengths does this household have?</label><hint>Select all that apply.</hint><itemset nodeset="instance('strength')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/livelihoods/strengths_other"><label>Please specify the other skill or strength</label></input><select ref="/data/livelihoods/challenges"><label>What are the main challenges facing this household?</label><hint>Select all that apply.</hint><itemset nodeset="instance('challenge')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/livelihoods/challenges_other"><label>Please specify the other challenge</label></input><select ref="/data/livelihoods/opportunities"><label>What would most help this community grow?</label><hint>Select all that apply.</hint><itemset nodeset="instance('opportunity')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/livelihoods/opportunities_other"><label>Please specify the other opportunity</label></input><input ref="/data/livelihoods/notes" appearance="multiline"><label>Interviewer notes</label><hint>Anything the categories above did not capture.</hint></input></group></h:body></h:html>